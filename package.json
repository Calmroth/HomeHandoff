{
  "name": "home-domain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Home Domain — household control surface for multi-vendor smart home (Plejd, Sonos, Shelly, Spotify, Tibber, weather).",
  "scripts": {
    "dev": "vite",
    "dev:lan": "cross-env VITE_HTTPS=1 vite",
    "dev:full": "concurrently --names VITE,HUB,SONOS --prefix-colors cyan,magenta,yellow \"npm run dev\" \"npm run hub:dev\" \"node ../node-sonos-http-api/server.js\"",
    "hub": "node server/index.js",
    "hub:dev": "node --watch server/index.js",
    "sonos": "node ../node-sonos-http-api/server.js",
    "build": "vite build",
    "preview": "vite preview --port 5183 --strictPort"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "suncalc": "^1.9.0",
    "vite": "^8.0.14",
    "vite-plugin-mkcert": "^2.0.0"
  }
}
